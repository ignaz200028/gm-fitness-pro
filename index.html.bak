<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0b0c0e">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="GM Fitness">
<link rel="manifest" href="manifest.webmanifest">
<title>GM Fitness Pro</title>
<style>
:root{--bg:#f3f4f6;--card:#fff;--ink:#111318;--muted:#737983;--line:#e3e5e8;--accent:#e30613;--green:#0a8f55;--dark:#0b0c0e;--shadow:0 8px 30px rgba(0,0,0,.06)}
*{box-sizing:border-box}html,body{margin:0;padding:0;background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","SF Pro Text",Inter,system-ui,sans-serif}
body{padding-bottom:calc(74px + env(safe-area-inset-bottom))}
button,input,select,textarea{font:inherit}button{cursor:pointer}
.appbar{position:sticky;top:0;z-index:40;background:rgba(11,12,14,.96);color:#fff;padding:calc(12px + env(safe-area-inset-top)) 16px 12px;backdrop-filter:blur(18px)}
.appbar .top{display:flex;justify-content:space-between;align-items:center;gap:10px}.brand{font-size:20px;font-weight:900;letter-spacing:-.4px}.sub{font-size:11px;color:#aeb2b8;margin-top:2px}
.container{max-width:760px;margin:auto;padding:14px 14px 24px}
.bottom{position:fixed;left:0;right:0;bottom:0;z-index:50;background:rgba(255,255,255,.96);border-top:1px solid var(--line);padding:8px 8px calc(8px + env(safe-area-inset-bottom));display:grid;grid-template-columns:repeat(5,1fr);gap:4px;backdrop-filter:blur(18px)}
.bottom button{border:0;background:transparent;color:#70747b;padding:7px 3px;border-radius:12px;font-size:10px;font-weight:800}.bottom button b{display:block;font-size:18px;line-height:18px;margin-bottom:2px}.bottom button.active{color:var(--ink);background:#f0f1f3}
.card{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:16px;margin-bottom:12px;box-shadow:var(--shadow)}
.hero{background:linear-gradient(135deg,#101114,#24262b);color:#fff;border:0}.hero h1{font-size:27px;margin:0 0 6px;letter-spacing:-.7px}.hero p{margin:0;color:#c5c8cd;font-size:13px}
.row{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.between{justify-content:space-between}.grow{flex:1}
h2{font-size:19px;letter-spacing:-.3px;margin:0 0 12px}h3{font-size:16px;margin:0 0 5px}.muted{color:var(--muted);font-size:12px;line-height:1.45}
.btn{border:0;border-radius:12px;padding:10px 13px;background:var(--dark);color:#fff;font-weight:800}.btn.light{background:#eef0f2;color:#17191d}.btn.red{background:var(--accent)}.btn.green{background:var(--green)}.btn.small{padding:7px 9px;font-size:12px}
input,select,textarea{width:100%;border:1px solid #d8dbe0;border-radius:12px;background:#fff;padding:11px 12px;outline:none}input:focus,select:focus,textarea:focus{border-color:#9297a0;box-shadow:0 0 0 3px #0000000a}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}.kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.kpi{background:#f6f7f8;border-radius:15px;padding:12px}.kpi .n{font-size:21px;font-weight:900}.kpi .l{font-size:10px;color:var(--muted);margin-top:2px}
.chip{display:inline-flex;align-items:center;gap:5px;padding:5px 8px;border-radius:999px;background:#f0f1f3;font-size:10px;font-weight:800;color:#565b62}.chip.red{background:#fff0f1;color:#b5000b}.chip.green{background:#eaf8f1;color:#087344}
.progress{height:8px;background:#e8eaed;border-radius:99px;overflow:hidden}.progress i{display:block;height:100%;background:var(--accent);border-radius:99px}
.search{position:relative;margin-bottom:10px}.search input{padding-left:40px}.search span{position:absolute;left:13px;top:10px;color:#858990}
.exercise-row{display:flex;align-items:center;gap:11px;padding:11px 0;border-bottom:1px solid var(--line)}.exercise-row:last-child{border-bottom:0}
.thumb{width:48px;height:48px;border-radius:14px;background:#15171a;color:#fff;display:grid;place-items:center;flex:0 0 48px;font-size:19px;font-weight:900}.exercise-main{min-width:0;flex:1}.exercise-main strong{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.exercise-main .meta{font-size:11px;color:var(--muted);margin-top:3px}.chev{color:#a2a6ac;font-size:22px}
.workout-card{padding:14px 0;border-bottom:1px solid var(--line)}.workout-card:last-child{border-bottom:0}
.set-head,.set-row{display:grid;grid-template-columns:38px 1fr 1fr 44px;gap:7px;align-items:center}.set-head{font-size:10px;color:#858990;padding:5px 0}.set-row{padding:5px 0}
.set-row input{padding:9px 7px;text-align:center}.check{width:28px;height:28px;accent-color:var(--green);justify-self:center}
.exercise-title{display:flex;gap:11px;align-items:center;margin-bottom:10px}.exercise-title .thumb{width:42px;height:42px;flex-basis:42px}
.prev{background:#f6f7f8;border-radius:13px;padding:9px 10px;margin:8px 0;font-size:12px}.prev b{font-size:13px}
.modal{position:fixed;inset:0;z-index:100;background:rgba(0,0,0,.5);display:flex;align-items:flex-end;justify-content:center}.sheet{background:#fff;width:min(760px,100%);max-height:92vh;overflow:auto;border-radius:24px 24px 0 0;padding:18px 15px calc(24px + env(safe-area-inset-bottom))}.handle{width:42px;height:5px;background:#d3d5d8;border-radius:99px;margin:0 auto 15px}
.section-title{display:flex;justify-content:space-between;align-items:center;margin:18px 0 8px}.history-item{padding:12px 0;border-bottom:1px solid var(--line)}.history-item:last-child{border-bottom:0}
canvas{width:100%;height:210px;border:1px solid var(--line);border-radius:14px;background:#fff}
.timer{font-size:42px;font-weight:950;text-align:center;letter-spacing:1px;margin:6px 0 12px}
.toggle{display:flex;align-items:center;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--line)}.switch{width:48px;height:28px;border-radius:99px;background:#d6d8dc;position:relative;border:0;padding:0}.switch i{position:absolute;width:22px;height:22px;left:3px;top:3px;background:#fff;border-radius:50%;transition:.2s}.switch.on{background:var(--green)}.switch.on i{left:23px}
.toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(88px + env(safe-area-inset-bottom));z-index:200;background:#111;color:#fff;padding:10px 14px;border-radius:12px;font-size:12px;box-shadow:0 8px 24px #0004}
.empty{text-align:center;padding:30px 10px;color:var(--muted)}.hidden{display:none!important}
@media(max-width:430px){.kpis{grid-template-columns:repeat(3,1fr)}.kpi .n{font-size:18px}}
</style>
</head>
<body>
<header class="appbar"><div class="top"><div><div class="brand">GM Fitness Pro</div><div class="sub">Diario · Programmi · Progressi</div></div><button class="btn small" onclick="openSettings()">⚙︎</button></div></header>
<main class="container"><section id="home"></section><section id="workout" class="hidden"></section><section id="library" class="hidden"></section><section id="progress" class="hidden"></section><section id="more" class="hidden"></section></main>
<nav class="bottom">
<button id="navHome" class="active" onclick="go('home')"><b>⌂</b>Oggi</button><button id="navWorkout" onclick="go('workout')"><b>▶</b>Allenati</button><button id="navLibrary" onclick="go('library')"><b>▦</b>Esercizi</button><button id="navProgress" onclick="go('progress')"><b>↗</b>Progressi</button><button id="navMore" onclick="go('more')"><b>•••</b>Altro</button>
</nav>
<div id="modalRoot"></div><div id="toastRoot"></div>
<script>
if('serviceWorker' in navigator){navigator.serviceWorker.register('./sw.js').catch(()=>{});}
const PROGRAMS={"Scheda 1 · 6–8 settimane": {"description": "Mesociclo principale · 3 allenamenti + addome", "workouts": [{"name": "Allenamento 1", "exercises": [["Panca alta bilanciere", 3, 6, 8, "2:00–2:30", ""], ["Lat machine presa neutra", 3, 8, 10, "2:00", ""], ["Leg press 45°", 3, 8, 10, "2:00–2:30", ""], ["Chest press", 2, 10, 12, "1:30", ""], ["Rematore T-bar", 2, 8, 12, "1:30", ""], ["Leg extension", 2, 12, 15, "1:00–1:15", "Drop set ultima"], ["Alzate laterali", 3, 12, 15, "1:00", "Drop set ultima"]]}, {"name": "Allenamento 2", "exercises": [["Hack squat", 3, 6, 8, "2:00–2:30", ""], ["Stacco rumeno", 3, 8, 10, "2:00", ""], ["Leg curl", 3, 10, 12, "1:30", ""], ["Shoulder press", 3, 6, 8, "2:00", ""], ["Alzate laterali ai cavi", 2, 12, 15, "1:00", ""], ["Curl bilanciere P45 + Pushdown tricipiti fune", 3, 8, 12, "1:00", "Superset"], ["Hammer curl + Tricipiti cavo alto", 3, 12, 15, "1:00", "Superset"]]}, {"name": "Allenamento 3", "exercises": [["Panca piana manubri presa neutra", 3, 6, 8, "2:00", ""], ["Rowing", 3, 8, 10, "2:00", ""], ["Leg extension", 3, 8, 10, "1:30", ""], ["Croci ai cavi chiusura bassa", 3, 12, 15, "1:00–1:15", ""], ["Leg curl", 2, 10, 15, "1:00–1:15", ""], ["Curl al cavo basso fune + Pushdown", 3, 12, 15, "1:00", "Superset"]]}, {"name": "Addome", "exercises": [["Crunch", 1, 30, 30, "0:30", "30 sec"], ["Crunch inverso", 1, 30, 30, "0:30", "30 sec"], ["Russian twist", 1, 30, 30, "0:30", "30 sec"]]}]}, "Scheda 2 · Progressione": {"description": "3 allenamenti · tecniche d'intensità incluse", "workouts": [{"name": "Allenamento 1", "exercises": [["Chest press", 4, 6, 8, "2:00", "Rest-pause ultima 6+2+1"], ["Panca inclinata manubri", 3, 8, 10, "1:30", "Drop set ultima -20%"], ["Croci ai cavi", 3, 12, 15, "1:00", "Eccentrica 3 sec"], ["Shoulder press", 3, 6, 8, "2:00", ""], ["Alzate laterali", 3, 12, 15, "1:00", "Doppio drop ultima"], ["Pushdown tricipiti fune", 3, 10, 12, "1:00", "Rest-pause ultima"], ["French press", 2, 8, 10, "1:30", ""]]}, {"name": "Allenamento 2", "exercises": [["Lat machine presa larga", 4, 6, 8, "2:00", "Rest-pause ultima"], ["Rowing", 4, 8, 8, "2:00", ""], ["Pulley basso", 3, 10, 12, "1:30", "Drop set ultima"], ["Face pull", 3, 12, 15, "1:00", ""], ["Curl bilanciere", 3, 8, 10, "1:30", "Negative lente"], ["Curl manubri alternati", 3, 10, 12, "1:00", ""], ["Curl al cavo", 2, 12, 12, "1:00", "Contrazione 2 sec"]]}, {"name": "Allenamento 3", "exercises": [["Leg press 45°", 4, 6, 8, "2:00", "Rest-pause ultima 6+2"], ["Leg extension", 3, 10, 10, "1:30", "Drop set triplo"], ["Stacco rumeno", 3, 8, 10, "2:00", "Eccentrica 3 sec"], ["Leg curl", 3, 12, 12, "1:15", "Drop set ultima"], ["Leg extension", 3, 12, 15, "1:00", ""], ["Calf press", 4, 15, 20, "1:00", ""], ["Alzate laterali", 3, 12, 12, "1:00", ""], ["Russian twist", 3, 20, 20, "0:45", ""], ["Crunch", 3, 20, 20, "0:45", ""]]}]}, "Scheda 3 · 26-04-26": {"description": "3 allenamenti · superserie indicate come da scheda", "workouts": [{"name": "Allenamento 1", "exercises": [["Chest press", 3, 8, 8, "1:00", ""], ["Croci ai cavi alti busto a 90°", 3, 12, 12, "1:00", "Superset"], ["Croci ai cavi bassi", 3, 12, 12, "1:00", "Superset"], ["Panca piana bilanciere", 3, 12, 12, "1:00", ""], ["Pullover", 3, 15, 15, "1:00", ""], ["Lat machine avanti", 3, 8, 8, "1:30", ""], ["Rowing", 3, 10, 10, "1:30", ""], ["Lat machine impugnatura inversa", 3, 10, 10, "1:00", ""], ["Pulley basso lat bar", 3, 12, 12, "1:00", ""]]}, {"name": "Allenamento 2", "exercises": [["Curl manubri alternati", 3, 10, 10, "1:00", ""], ["Curl a martello", 3, 10, 10, "1:00", ""], ["Curl bilanciere", 3, 10, 10, "1:00", ""], ["Curl fune", 3, 12, 12, "1:00", ""], ["Tricipiti panca piana manubri", 3, 10, 10, "1:00", ""], ["French press manubri", 3, 12, 12, "1:00", ""], ["Tricipiti spalle al cavo basso", 3, 10, 10, "1:00", ""], ["Tricipiti straps", 3, 12, 12, "1:00", ""], ["Kick back manubrio", 3, 30, 30, "1:00", ""], ["Rowing", 3, 15, 15, "1:00", ""]]}, {"name": "Allenamento 3", "exercises": [["Leg press 45°", 4, 8, 12, "1:30", "12-10-10-8"], ["Leg curl", 4, 8, 12, "1:30", "12-10-10-8"], ["Leg extension", 3, 10, 10, "1:30", ""], ["Calf press", 3, 20, 20, "1:00", ""], ["Lento avanti", 3, 8, 8, "1:30", ""], ["Spinte in alto a martello", 3, 15, 15, "1:00", ""], ["Alzate a 90°", 3, 12, 12, "1:00", ""], ["Alzate laterali", 3, 12, 12, "1:00", ""]]}]}, "Scheda 4 · 28-02-26": {"description": "6 settimane · superserie", "workouts": [{"name": "Allenamento 1", "exercises": [["Panca alta bilanciere + Lat machine avanti", 3, 8, 8, "1:30", "Superset"], ["Croci ai cavi + Rowing", 4, 10, 10, "1:20", "Superset"], ["Panca piana manubri presa neutra + Pullover", 3, 12, 12, "1:20", "Superset"], ["Pectoral machine + Pulley basso", 3, 20, 20, "1:00", "Superset"]]}, {"name": "Allenamento 2", "exercises": [["Curl bilanciere + Tricipiti panca piana manubri", 3, 8, 8, "1:30", "Superset"], ["Curl bilanciere P45 + Kick back manubrio", 3, 10, 10, "1:20", "Superset"], ["Curl fune + Tricipiti straps", 3, 12, 15, "1:00", "Superset"], ["Hammer curl + Tricipiti spalle al cavo basso", 3, 20, 20, "1:00", "Superset"]]}, {"name": "Allenamento 3", "exercises": [["Leg press 45° + Spinte in alto a martello", 3, 8, 8, "1:30", "Superset"], ["Leg extension + Alzate laterali", 3, 10, 10, "1:20", "Superset"], ["Stacchi rumeni manubri + Alzate frontali a martello p.30", 3, 12, 12, "1:00", "Superset"], ["Leg curl + Face pull", 3, 10, 10, "1:00", "Superset"], ["Shoulder press", 4, 6, 6, "2:00", ""], ["Alzate frontali a martello p.30", 4, 8, 8, "1:40", ""], ["Face pull", 3, 10, 10, "1:20", ""], ["Leg press 45°", 4, 8, 8, "1:40", ""], ["Leg extension", 3, 8, 8, "1:30", ""], ["Leg curl", 3, 8, 8, "1:15", ""], ["Calf press", 3, 20, 20, "1:00", "Superset corpo libero 20+20"]]}]}};
