"Manubrio"}, {"id": "ex23", "name": "Pulley basso", "muscle": "Dorso", "equipment": "Cavi"}, {"id": "ex24", "name": "Pulley basso lat bar", "muscle": "Dorso", "equipment": "Cavi"}, {"id": "ex25", "name": "Face pull", "muscle": "Dorso/Spalle", "equipment": "Cavi"}, {"id": "ex26", "name": "Pullover ai cavi", "muscle": "Dorso", "equipment": "Cavi"}, {"id": "ex27", "name": "Leg press 45°", "muscle": "Gambe", "equipment": "Macchina"}, {"id": "ex28", "name": "Hack squat", "muscle": "Gambe", "equipment": "Macchina"}, {"id": "ex29", "name": "Squat bilanciere", "muscle": "Gambe", "equipment": "Bilanciere"}, {"id": "ex30", "name": "Goblet squat", "muscle": "Gambe", "equipment": "Manubrio"}, {"id": "ex31", "name": "Stacco rumeno", "muscle": "Femorali/Glutei", "equipment": "Bilanciere"}, {"id": "ex32", "name": "Stacchi rumeni manubri", "muscle": "Femorali/Glutei", "equipment": "Manubri"}, {"id": "ex33", "name": "Leg extension", "muscle": "Quadricipiti", "equipment": "Macchina"}, {"id": "ex34", "name": "Leg curl", "muscle": "Femorali", "equipment": "Macchina"}, {"id": "ex35", "name": "Calf press", "muscle": "Polpacci", "equipment": "Macchina"}, {"id": "ex36", "name": "Calf in piedi", "muscle": "Polpacci", "equipment": "Macchina"}, {"id": "ex37", "name": "Affondi", "muscle": "Gambe", "equipment": "Manubri"}, {"id": "ex38", "name": "Bulgarian split squat", "muscle": "Gambe", "equipment": "Manubri"}, {"id": "ex39", "name": "Hip thrust", "muscle": "Glutei", "equipment": "Bilanciere"}, {"id": "ex40", "name": "Abductor machine", "muscle": "Glutei", "equipment": "Macchina"}, {"id": "ex41", "name": "Adductor machine", "muscle": "Adduttori", "equipment": "Macchina"}, {"id": "ex42", "name": "Shoulder press", "muscle": "Spalle", "equipment": "Macchina"}, {"id": "ex43", "name": "Lento avanti", "muscle": "Spalle", "equipment": "Bilanciere"}, {"id": "ex44", "name": "Spinte in alto a martello", "muscle": "Spalle", "equipment": "Manubri"}, {"id": "ex45", "name": "Alzate laterali", "muscle": "Spalle", "equipment": "Manubri"}, {"id": "ex46", "name": "Alzate laterali ai cavi", "muscle": "Spalle", "equipment": "Cavi"}, {"id": "ex47", "name": "Alzate frontali", "muscle": "Spalle", "equipment": "Manubri"}, {"id": "ex48", "name": "Alzate frontali a martello p.30", "muscle": "Spalle", "equipment": "Manubri"}, {"id": "ex49", "name": "Alzate a 90°", "muscle": "Spalle", "equipment": "Manubri"}, {"id": "ex50", "name": "Reverse fly", "muscle": "Spalle", "equipment": "Macchina"}, {"id": "ex51", "name": "Arnold press", "muscle": "Spalle", "equipment": "Manubri"}, {"id": "ex52", "name": "Curl bilanciere", "muscle": "Bicipiti", "equipment": "Bilanciere"}, {"id": "ex53", "name": "Curl bilanciere P45", "muscle": "Bicipiti", "equipment": "Bilanciere"}, {"id": "ex54", "name": "Curl manubri alternati", "muscle": "Bicipiti", "equipment": "Manubri"}, {"id": "ex55", "name": "Hammer curl", "muscle": "Bicipiti", "equipment": "Manubri"}, {"id": "ex56", "name": "Curl a martello", "muscle": "Bicipiti", "equipment": "Manubri"}, {"id": "ex57", "name": "Curl al cavo basso fune", "muscle": "Bicipiti", "equipment": "Cavi"}, {"id": "ex58", "name": "Curl al cavo", "muscle": "Bicipiti", "equipment": "Cavi"}, {"id": "ex59", "name": "Curl fune", "muscle": "Bicipiti", "equipment": "Cavi"}, {"id": "ex60", "name": "Pushdown tricipiti fune", "muscle": "Tricipiti", "equipment": "Cavi"}, {"id": "ex61", "name": "Pushdown", "muscle": "Tricipiti", "equipment": "Cavi"}, {"id": "ex62", "name": "French press", "muscle": "Tricipiti", "equipment": "Bilanciere"}, {"id": "ex63", "name": "French press manubri", "muscle": "Tricipiti", "equipment": "Manubri"}, {"id": "ex64", "name": "Tricipiti panca piana manubri", "muscle": "Tricipiti", "equipment": "Manubri"}, {"id": "ex65", "name": "Tricipiti straps", "muscle": "Tricipiti", "equipment": "Cavi"}, {"id": "ex66", "name": "Tricipiti spalle al cavo basso", "muscle": "Tricipiti", "equipment": "Cavi"}, {"id": "ex67", "name": "Kick back manubrio", "muscle": "Tricipiti", "equipment": "Manubri"}, {"id": "ex68", "name": "Crunch", "muscle": "Addome", "equipment": "Corpo libero"}, {"id": "ex69", "name": "Crunch inverso", "muscle": "Addome", "equipment": "Corpo libero"}, {"id": "ex70", "name": "Russian twist", "muscle": "Addome", "equipment": "Corpo libero"}, {"id": "ex71", "name": "Plank", "muscle": "Addome", "equipment": "Corpo libero"}, {"id": "ex72", "name": "Leg raise", "muscle": "Addome", "equipment": "Corpo libero"}, {"id": "ex73", "name": "Panca declinata", "muscle": "Petto", "equipment": "Bilanciere"}, {"id": "ex74", "name": "Smith machine squat", "muscle": "Gambe", "equipment": "Macchina"}, {"id": "ex75", "name": "Sissy squat", "muscle": "Quadricipiti", "equipment": "Corpo libero"}, {"id": "ex76", "name": "Good morning", "muscle": "Femorali/Glutei", "equipment": "Bilanciere"}, {"id": "ex77", "name": "Cable lateral raise", "muscle": "Spalle", "equipment": "Cavi"}, {"id": "ex78", "name": "Cable crossover", "muscle": "Petto", "equipment": "Cavi"}, {"id": "ex79", "name": "Seated cable row", "muscle": "Dorso", "equipment": "Cavi"}, {"id": "ex80", "name": "Chest supported row", "muscle": "Dorso", "equipment": "Macchina"}, {"id": "ex81", "name": "Dumbbell bench press", "muscle": "Petto", "equipment": "Manubri"}, {"id": "ex82", "name": "Dumbbell shoulder press", "muscle": "Spalle", "equipment": "Manubri"}, {"id": "ex83", "name": "EZ-bar curl", "muscle": "Bicipiti", "equipment": "Bilanciere"}, {"id": "ex84", "name": "Overhead cable extension", "muscle": "Tricipiti", "equipment": "Cavi"}, {"id": "ex85", "name": "Rope overhead extension", "muscle": "Tricipiti", "equipment": "Cavi"}, {"id": "ex86", "name": "Standing calf raise", "muscle": "Polpacci", "equipment": "Macchina"}, {"id": "ex87", "name": "Hanging knee raise", "muscle": "Addome", "equipment": "Corpo libero"}, {"id": "ex88", "name": "Ab wheel rollout", "muscle": "Addome", "equipment": "Corpo libero"}];
const MUSCLE_ICON={'Petto':'P','Dorso':'D','Gambe':'G','Femorali/Glutei':'F','Quadricipiti':'Q','Spalle':'S','Bicipiti':'B','Tricipiti':'T','Addome':'A','Polpacci':'C','Glutei':'G','Dorso/Petto':'D','Dorso/Spalle':'D','Petto/Tricipiti':'P','Adduttori':'A'};
const STORE='gmFitnessProDataV1',OLD='gmFitnessData';
let state=JSON.parse(localStorage.getItem(STORE)||'null');
if(!state){const old=JSON.parse(localStorage.getItem(OLD)||'null');state={programs:PROGRAMS,logs:old?.logs||[],fixed:{},favorites:[],customExercises:[],currentProgram:Object.keys(PROGRAMS)[0],currentWorkout:0,autoRest:true,customRest:100};}
state.programs=state.programs||PROGRAMS;state.logs=state.logs||[];state.fixed=state.fixed||{};state.customExercises=state.customExercises||[];state.customRest=state.customRest||100;
let timer=null,remaining=0;
function save(){localStorage.setItem(STORE,JSON.stringify(state));}
function esc(s){return String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));}
function allExercises(){return [...LIBRARY,...state.customExercises];}
function icon(name){const x=allExercises().find(e=>e.name===name)||LIBRARY.find(e=>name.toLowerCase().includes(e.name.toLowerCase()));return MUSCLE_ICON[x?.muscle]||'•';}
function muscleOf(name){const x=allExercises().find(e=>e.name===name)||{};return x.muscle||'Personalizzato';}
function today(){return new Date().toISOString().slice(0,10);}
function fmtDate(d){return new Date(d+'T12:00').toLocaleDateString('it-IT',{day:'2-digit',month:'short'});}
function getLast(name,program){let arr=state.logs.filter(x=>x.exercise===name&&x.done);if(program){const same=arr.filter(x=>x.program===program);if(same.length)arr=same;}arr.sort((a,b)=>(b.date+b.time).localeCompare(a.date+a.time));const by={};arr.forEach(x=>{if(!by[x.set])by[x.set]=x});return Object.values(by).sort((a,b)=>a.set-b.set);}
function lastSummary(name){const a=getLast(name);return a.length?a.map(x=>`${x.weight||'—'} kg × ${x.reps||'—'}`).join(' · '):'Nessuna registrazione';}
function toast(msg){const r=document.getElementById('toastRoot');r.innerHTML=`<div class="toast">${esc(msg)}</div>`;setTimeout(()=>r.innerHTML='',1800);}
function go(tab){['home','workout','library','progress','more'].forEach(x=>document.getElementById(x).classList.toggle('hidden',x!==tab));document.querySelectorAll('.bottom button').forEach(b=>b.classList.remove('active'));document.getElementById('nav'+tab[0].toUpperCase()+tab.slice(1)).classList.add('active');({home:renderHome,workout:renderWorkout,library:renderLibrary,progress:renderProgress,more:renderMore})[tab]();window.scrollTo(0,0);}
function exerciseRow(e,onclick,showPrev=false){const n=e[0],last=getLast(n,state.currentProgram);return `<div class="exercise-row" onclick="${onclick}" style="cursor:pointer"><div class="thumb">${icon(n)}</div><div class="exercise-main"><strong>${esc(n)}</strong><div class="meta">${e[1]} × ${e[2]}–${e[3]} reps · recupero ${esc(e[4])}</div>${showPrev?`<div class="meta">Ultima: <b>${esc(last.length?lastSummary(n):'—')}</b></div>`:''}</div><div class="chev">›</div></div>`;}
function renderHome(){const p=state.programs[state.currentProgram],wi=state.currentWorkout||0,w=p?.workouts?.[wi],done=state.logs.filter(x=>x.date===today()&&x.done).length,total=w?w.exercises.reduce((a,e)=>a+e[1],0):0,pct=total?Math.min(100,done/total*100):0;
document.getElementById('home').innerHTML=`<div class="card hero"><h1>Pronto per allenarti?</h1><p>${esc(state.currentProgram)} · ${esc(w?.name||'Seleziona allenamento')}</p><div style="margin-top:16px" class="progress"><i style="width:${pct}%"></i></div><div class="row between" style="margin-top:8px"><span style="color:#bfc3c9;font-size:12px">${done} serie completate</span><button class="btn red" onclick="go('workout')">Inizia</button></div></div>
<div class="kpis"><div class="kpi"><div class="n">${state.logs.filter(x=>x.done).length}</div><div class="l">Serie totali</div></div><div class="kpi"><div class="n">${new Set(state.logs.filter(x=>x.done).map(x=>x.date)).size}</div><div class="l">Giorni</div></div><div class="kpi"><div class="n">${personalRecords().length}</div><div class="l">PR</div></div></div>
<div class="section-title"><h2>Allenamento di oggi</h2><button class="btn light small" onclick="cycleWorkout()">Cambia</button></div>
<div class="card">${w?w.exercises.map(e=>exerciseRow(e,`openExercise('${esc(e[0])}')`,true)).join(''):'<div class="empty">Nessun allenamento</div>'}</div>
<div class="section-title"><h2>Ultimi allenamenti</h2></div><div class="card">${recentSessions().slice(0,4).map(s=>`<div class="history-item"><div class="row between"><b>${fmtDate(s.date)}</b><span class="chip">${esc(s.program)}</span></div><div class="muted">${s.count} serie · ${s.volume.toFixed(0)} kg volume</div></div>`).join('')||'<div class="empty">Completa il primo allenamento per iniziare lo storico.</div>'}</div>`;}
function cycleWorkout(){const p=state.programs[state.currentProgram];state.currentWorkout=(state.currentWorkout+1)%p.workouts.length;save();renderHome();}
function renderWorkout(){const p=state.programs[state.currentProgram],w=p.workouts[state.currentWorkout]||p.workouts[0];let h=`<div class="section-title"><div><h2>${esc(w.name)}</h2><div class="muted">${esc(state.currentProgram)}</div></div><select style="width:auto;max-width:160px" onchange="state.currentWorkout=Number(this.value);save();renderWorkout()">${p.workouts.map((x,i)=>`<option value="${i}" ${i===state.currentWorkout?'selected':''}>${esc(x.name)}</option>`).join('')}</select></div><div class="card"><div class="row between"><span class="chip">${w.exercises.length} esercizi</span><span class="chip green">${w.exercises.reduce((a,e)=>a+e[1],0)} serie</span></div></div>`;
w.exercises.forEach((e,i)=>{e._workout=w.name;h+=renderExerciseCard(e,i);});h+=`<div class="card">
<div class="timer" id="mainTimer">${fmtTime(remaining)}</div>
<div class="row" style="justify-content:center">
<button class="btn light" onclick="startTimer(60)">60s</button>
<button class="btn light" onclick="startTimer(90)">90s</button>
<button class="btn light" onclick="startTimer(120)">120s</button>
<button class="btn light" onclick="startTimer(150)">150s</button>
</div>
<div class="row" style="margin-top:10px">
<input id="customRest" type="number" min="1" max="3600" step="1" inputmode="numeric"
placeholder="Recupero personalizzato (secondi)" value="${state.customRest||''}"
style="flex:1">
<button class="btn red" onclick="startCustomTimer()">Avvia</button>
</div>
<div class="muted" style="margin-top:7px;text-align:center">
Puoi inserire qualsiasi valore, ad esempio 100 secondi, 75, 135, 180…
</div>
</div>`;document.getElementById('workout').innerHTML=h;}
function renderExerciseCard(e,idx){const n=e[0],last=getLast(n,state.currentProgram);let h=`<div class="card workout-card"><div class="exercise-title" onclick="openExercise('${esc(n)}')"><div class="thumb">${icon(n)}</div><div class="grow"><h3>${esc(n)}</h3><div class="muted">${e[1]} serie · ${e[2]}–${e[3]} reps · ${esc(e[4])}</div></div><div class="chev">›</div></div>`;
if(last.length)h+=`<div class="prev"><b>ULTIMA VOLTA</b><br>${esc(last.map(x=>`${x.weight||'—'} kg × ${x.reps||'—'}`).join(' · '))}</div>`;
h+=`<div class="set-head"><span>Serie</span><span>Kg</span><span>Rip.</span><span>✓</span></div>`;
for(let s=1;s<=e[1];s++){const old=state.logs.find(x=>x.date===today()&&x.program===state.currentProgram&&x.workout===e._workout&&x.exercise===n&&x.set===s)||{},prev=last.find(x=>x.set===s)||last[0]||{};h+=`<div class="set-row"><span>${s}</span><input id="kg_${idx}_${s}" type="number" step="0.5" inputmode="decimal" value="${esc(old.weight??prev.weight??'')}" placeholder="${prev.weight?'prev '+prev.weight:'kg'}"><input id="rp_${idx}_${s}" type="number" inputmode="numeric" value="${esc(old.reps??'')}" placeholder="${prev.reps||e[2]+'-'+e[3]}"><input class="check" type="checkbox" id="ok_${idx}_${s}" ${old.done?'checked':''} onchange="completeSet(${idx},${s})"></div>`;}
h+=`<div class="row" style="margin-top:8px"><button class="btn green small" onclick="saveExercisePro(${idx})">Salva</button><button class="btn light small" onclick="openExercise('${esc(n)}')">Storico</button>${e[5]?`<span class="chip">${esc(e[5])}</span>`:''}</div></div>`;return h;}
function currentExercise(idx){return state.programs[state.currentProgram].workouts[state.currentWorkout].exercises[idx];}
function completeSet(idx,s){const e=currentExercise(idx);if(document.getElementById(`ok_${idx}_${s}`).checked){saveExercisePro(idx,true);if(state.autoRest)startTimer(parseRest(e[4]));}}
function saveExercisePro(idx,silent=false){const e=currentExercise(idx),n=e[0],d=today();for(let s=1;s<=e[1];s++){const kg=document.getElementById(`kg_${idx}_${s}`)?.value||'',rp=document.getElementById(`rp_${idx}_${s}`)?.value||'',ok=document.getElementById(`ok_${idx}_${s}`)?.checked||false;if(!kg&&!rp&&!ok)continue;let x=state.logs.find(x=>x.date===d&&x.program===state.currentProgram&&x.workout===e._workout&&x.exercise===n&&x.set===s);if(!x){x={date:d,time:new Date().toTimeString().slice(0,8),program:state.currentProgram,workout:e._workout,exercise:n,set:s};state.logs.push(x);}x.weight=kg;x.reps=rp;x.done=ok;}save();if(!silent){toast('Esercizio salvato');renderWorkout();}}
function parseRest(s){const m=String(s).match(/(\d+)\s*:\s*(\d+)/);if(m)return Number(m[1])*60+Number(m[2]);const nums=String(s).match(/\d+/g);return nums?Number(nums[0]):60;}
function fmtTime(n){return String(Math.floor(n/60)).padStart(2,'0')+':'+String(n%60).padStart(2,'0');}
function startTimer(n){stopTimer();remaining=n;updateTimers();timer=setInterval(()=>{remaining--;updateTimers();if(remaining<=0){stopTimer();navigator.vibrate?.([180,80,180]);toast('Recupero terminato');}},1000);}
function startCustomTimer(){
const el=document.getElementById('customRest');
const n=Math.max(1,Math.min(3600,parseInt(el?.value||state.customRest||100,10)));
state.customRest=n;save();startTimer(n);toast('Recupero impostato a '+n+' secondi');
}
function stopTimer(){if(timer)clearInterval(timer);timer=null;}function updateTimers(){const x=document.getElementById('mainTimer');if(x)x.textContent=fmtTime(remaining);}
function openExercise(name){const last=getLast(name),hist=state.logs.filter(x=>x.exercise===name&&x.done).sort((a,b)=>(b.date+b.time).localeCompare(a.date+a.time)),weights=hist.filter(x=>x.weight).map(x=>Number(x.weight)),max=weights.length?Math.max(...weights):0,one=hist.filter(x=>x.weight&&x.reps).reduce((m,x)=>Math.max(m,Number(x.weight)*(1+Number(x.reps)/30)),0);
document.getElementById('modalRoot').innerHTML=`<div class="modal" onclick="if(event.target===this)closeModal()"><div class="sheet"><div class="handle"></div><div class="row between"><div><h2>${esc(name)}</h2><div class="muted">${esc(muscleOf(name))}</div></div><button class="btn light small" onclick="closeModal()">Chiudi</button></div>
<div class="kpis" style="margin-top:12px"><div class="kpi"><div class="n">${max?max+' kg':'—'}</div><div class="l">Peso massimo</div></div><div class="kpi"><div class="n">${one?one.toFixed(1):'—'}</div><div class="l">1RM stimato</div></div><div class="kpi"><div class="n">${hist.length}</div><div class="l">Serie registrate</div></div></div>
<div class="section-title"><h2>Ultima performance</h2><span class="chip">${last.length?'Ultimo allenamento':'Nessun dato'}</span></div>
<div class="card" style="margin:0 0 12px">${last.length?last.map(x=>`<div class="row between" style="padding:7px 0;border-bottom:1px solid var(--line)"><span>Serie ${x.set}</span><b>${x.weight||'—'} kg × ${x.reps||'—'}</b></div>`).join(''):'<div class="empty">Quando registri questo esercizio, qui comparirà automaticamente il peso e le ripetizioni dell’ultima volta.</div>'}</div>
<div class="section-title"><h2>Andamento carico</h2></div><canvas id="exChart" width="720" height="210"></canvas>
<div class="section-title"><h2>Storico</h2></div><div class="card" style="margin:0">${hist.slice(0,20).map(x=>`<div class="history-item"><div class="row between"><b>${fmtDate(x.date)}</b><span>${x.weight||'—'} kg × ${x.reps||'—'}</span></div><div class="muted">${esc(x.program)} · ${esc(x.workout)}</div></div>`).join('')||'<div class="empty">Nessuno storico.</div>'}</div>
<div class="row" style="margin-top:12px"><button class="btn red grow" onclick="closeModal();go('workout')">Registra ora</button><button class="btn light" onclick="toggleFixed('${esc(name)}')">${state.fixed[name]?'✓ Fisso':'Imposta fisso'}</button></div>
</div></div>`;setTimeout(()=>drawExerciseChart(hist),20);}
function drawExerciseChart(hist){const c=document.getElementById('exChart');if(!c)return;const ctx=c.getContext('2d');ctx.clearRect(0,0,c.width,c.height);const pts=hist.filter(x=>x.weight).sort((a,b)=>(a.date+a.time).localeCompare(b.date+b.time));if(!pts.length){ctx.fillStyle='#888';ctx.font='14px sans-serif';ctx.fillText('Registra il primo carico per vedere il grafico',20,35);return;}const vals=pts.map(x=>Number(x.weight)),min=Math.min(...vals),max=Math.max(...vals),span=Math.max(1,max-min),p=42,W=c.width,H=c.height;ctx.strokeStyle='#ddd';ctx.beginPath();ctx.moveTo(p,15);ctx.lineTo(p,H-30);ctx.lineTo(W-15,H-30);ctx.stroke();ctx.fillStyle='#666';ctx.font='12px sans-serif';ctx.fillText(max+' kg',5,22);ctx.fillText(min+' kg',5,H-34);ctx.strokeStyle='#e30613';ctx.lineWidth=3;ctx.beginPath();pts.forEach((x,i)=>{const xx=p+(i/Math.max(1,pts.length-1))*(W-p-20),yy=H-30-((Number(x.weight)-min)/span)*(H-50);i?ctx.lineTo(xx,yy):ctx.moveTo(xx,yy);});ctx.stroke();}
function toggleFixed(name){state.fixed[name]=!state.fixed[name];save();toast(state.fixed[name]?'Esercizio impostato come fisso':'Esercizio non più fisso');openExercise(name);}
let libQ='',libMuscle='Tutti';
function renderLibrary(){const arr=allExercises().filter(e=>(!libQ||e.name.toLowerCase().includes(libQ.toLowerCase()))&&(libMuscle==='Tutti'||e.muscle===libMuscle));document.getElementById('library').innerHTML=`<div class="section-title"><div><h2>Libreria esercizi</h2><div class="muted">${allExercises().length} esercizi disponibili</div></div><button class="btn small" onclick="newExercise()">+ Crea</button></div><div class="search"><span>⌕</span><input value="${esc(libQ)}" placeholder="Cerca esercizio…" oninput="libQ=this.value;renderLibrary()"></div><select onchange="libMuscle=this.value;renderLibrary()" style="margin-bottom:8px"><option>Tutti</option>${[...new Set(allExercises().map(e=>e.muscle))].sort().map(m=>`<option ${m===libMuscle?'selected':''}>${esc(m)}</option>`).join('')}</select><div class="card">${arr.map(e=>`<div class="exercise-row" onclick="openExercise('${esc(e.name)}')"><div class="thumb">${icon(e.name)}</div><div class="exercise-main"><strong>${esc(e.name)}</strong><div class="meta">${esc(e.muscle)} · ${esc(e.equipment)} · ${state.fixed[e.name]?'Fisso · ':''}Ultima: ${esc(lastSummary(e.name))}</div></div><div class="chev">›</div></div>`).join('')||'<div class="empty">Nessun esercizio trovato.</div>'}</div>`;}
function newExercise(){document.getElementById('modalRoot').innerHTML=`<div class="modal"><div class="sheet"><div class="handle"></div><h2>Nuovo esercizio</h2><input id="ceName" placeholder="Nome esercizio"><select id="ceMuscle" style="margin-top:8px"><option>Petto</option><option>Dorso</option><option>Gambe</option><option>Spalle</option><option>Bicipiti</option><option>Tricipiti</option><option>Addome</option><option>Altro</option></select><input id="ceEq" placeholder="Attrezzatura" style="margin-top:8px"><div class="row" style="margin-top:10px"><button class="btn light grow" onclick="closeModal()">Annulla</button><button class="btn green grow" onclick="createExercise()">Salva</button></div></div></div>`;}
function createExercise(){const n=document.getElementById('ceName').value.trim();if(!n)return;state.customExercises.push({id:'custom'+Date.now(),name:n,muscle:document.getElementById('ceMuscle').value,equipment:document.getElementById('ceEq').value||'Personalizzato'});save();closeModal();renderLibrary();toast('Esercizio aggiunto');}
function closeModal(){document.getElementById('modalRoot').innerHTML='';}
function personalRecords(){const out={};state.logs.filter(x=>x.done&&x.weight).forEach(x=>{const k=x.exercise,score=Number(x.weight)*(1+(Number(x.reps)||0)/30);if(!out[k]||score>out[k].score)out[k]={score,x};});return Object.values(out).map(v=>v.x);}
function recentSessions(){const by={};state.logs.filter(x=>x.done).forEach(x=>{const k=x.date+'|'+x.program+'|'+x.workout;(by[k]??=[]).push(x);});return Object.entries(by).map(([k,a])=>{const [date,program,workout]=k.split('|');return {date,program,workout,count:a.length,volume:a.reduce((s,x)=>s+(Number(x.weight)||0)*(Number(x.reps)||0),0)}}).sort((a,b)=>b.date.localeCompare(a.date));}
function renderProgress(){const prs=personalRecords().sort((a,b)=>(b.date+b.time).localeCompare(a.date+a.time));document.getElementById('progress').innerHTML=`<div class="section-title"><h2>Progressi</h2></div><div class="kpis"><div class="kpi"><div class="n">${state.logs.filter(x=>x.done).length}</div><div class="l">Serie</div></div><div class="kpi"><div class="n">${recentSessions().length}</div><div class="l">Allenamenti</div></div><div class="kpi"><div class="n">${prs.length}</div><div class="l">PR esercizi</div></div></div><div class="section-title"><h2>Record personali</h2></div><div class="card">${prs.slice(0,30).map(x=>`<div class="exercise-row" onclick="openExercise('${esc(x.exercise)}')"><div class="thumb">${icon(x.exercise)}</div><div class="exercise-main"><strong>${esc(x.exercise)}</strong><div class="meta">${fmtDate(x.date)} · ${x.weight||'—'} kg × ${x.reps||'—'}</div></div><div class="chip red">PR</div></div>`).join('')||'<div class="empty">I tuoi PR compariranno qui.</div>'}</div><div class="section-title"><h2>Storico allenamenti</h2></div><div class="card">${recentSessions().slice(0,30).map(s=>`<div class="history-item"><div class="row between"><b>${fmtDate(s.date)}</b><span class="chip">${esc(s.workout)}</span></div><div class="muted">${esc(s.program)} · ${s.count} serie · ${s.volume.toFixed(0)} kg volume</div></div>`).join('')||'<div class="empty">Nessun allenamento registrato.</div>'}</div>`;}
function renderMore(){document.getElementById('more').innerHTML=`<div class="section-title"><h2>Programmi</h2><button class="btn small" onclick="newProgram()">+ Crea</button></div>${Object.entries(state.programs).map(([name,p])=>`<div class="card"><div class="row between"><div><h3>${esc(name)}</h3><div class="muted">${esc(p.description)} · ${p.workouts.length} allenamenti</div></div>${state.currentProgram===name?'<span class="chip green">Attivo</span>':''}</div><div class="row" style="margin-top:10px"><button class="btn small" onclick="selectProgram('${esc(name)}')">Usa programma</button><button class="btn light small" onclick="showProgram('${esc(name)}')">Dettagli</button></div></div>`).join('')}<div class="card"><h3>Backup e impostazioni</h3><div class="toggle"><span>Recupero automatico dopo una serie</span><button class="switch ${state.autoRest?'on':''}" onclick="state.autoRest=!state.autoRest;save();renderMore()"><i></i></button></div><div class="row" style="margin-top:12px"><button class="btn" onclick="exportBackup()">Esporta backup</button><label class="btn light">Importa backup<input type="file" accept=".json" onchange="importBackup(event)" style="display:none"></label></div></div>`;}
function selectProgram(name){state.currentProgram=name;state.currentWorkout=0;save();toast('Programma attivo');renderMore();}
function showProgram(name){const p=state.programs[name];document.getElementById('modalRoot').innerHTML=`<div class="modal"><div class="sheet"><div class="handle"></div><div class="row between"><h2>${esc(name)}</h2><button class="btn light small" onclick="closeModal()">Chiudi</button></div><div class="muted">${esc(p.description)}</div>${p.workouts.map(w=>`<div class="section-title"><h3>${esc(w.name)}</h3><span class="chip">${w.exercises.length} esercizi</span></div><div class="card">${w.exercises.map(e=>exerciseRow(e,`openExercise('${esc(e[0])}')`,true)).join('')}</div>`).join('')}</div></div>`;}
function newProgram(){const n=prompt('Nome del nuovo programma');if(!n)return;state.programs[n]={description:'Programma personalizzato',workouts:[{name:'Allenamento 1',exercises:[]}]};save();renderMore();}
function openSettings(){document.getElementById('modalRoot').innerHTML=`<div class="modal"><div class="sheet"><div class="handle"></div><div class="row between"><h2>Impostazioni</h2><button class="btn light small" onclick="closeModal()">Chiudi</button></div><div class="toggle"><span>Recupero automatico</span><button class="switch ${state.autoRest?'on':''}" onclick="state.autoRest=!state.autoRest;save();openSettings()"><i></i></button></div>
<div class="section-title"><h3>Recupero personalizzato</h3></div>
<div class="row"><input id="settingsRest" type="number" min="1" max="3600" step="1" inputmode="numeric" value="${state.customRest||100}" placeholder="Secondi"><button class="btn red" onclick="saveCustomRest()">Salva</button></div>
<div class="muted" style="margin-top:7px">I pulsanti rapidi 60/90/120/150 s restano disponibili. Qui puoi impostare qualsiasi valore in secondi.</div>
<div class="toggle"><span>Dati salvati sul dispositivo</span><span class="chip green">Locale</span></div><div class="muted" style="margin-top:12px">Esporta periodicamente un backup prima di cambiare dispositivo o browser.</div></div></div>`;}
function saveCustomRest(){
const n=Math.max(1,Math.min(3600,parseInt(document.getElementById('settingsRest')?.value||100,10)));
state.customRest=n;save();toast('Recupero personalizzato salvato: '+n+' s');openSettings();
}
function exportBackup(){const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(state,null,2)],{type:'application/json'}));a.download='gm-fitness-pro-backup.json';a.click();toast('Backup esportato');}
function importBackup(ev){const f=ev.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{try{const x=JSON.parse(r.result);if(!x.logs||!x.programs)throw 0;state=x;save();go('home');toast('Backup importato');}catch(e){toast('Backup non valido');}};r.readAsText(f);}
save();go('home');
</script>
</body></html>